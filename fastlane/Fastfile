default_platform(:ios)

def repo_root
  File.expand_path("..", __dir__)
end

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: File.read(File.join(repo_root, "secrets/apple/key_id")).strip,
      issuer_id: File.read(File.join(repo_root, "secrets/apple/issuer_id")).strip,
      key_filepath: Dir[File.join(repo_root, "secrets/apple/AuthKey_*.p8")].first,
      in_house: false
    )
  end

  desc "Upload App Store listing text only (no IPA, no screenshots)"
  lane :upload_asc_listing do
    # Prefer Spaceship for first versions — deliver can crash on missing review detail ("No data").
    require "spaceship"

    meta = File.join(repo_root, "fastlane/metadata")
    en = File.join(meta, "en-US")
    read = ->(path) { File.read(path).strip }

    key_id = File.read(File.join(repo_root, "secrets/apple/key_id")).strip
    issuer_id = File.read(File.join(repo_root, "secrets/apple/issuer_id")).strip
    key_filepath = Dir[File.join(repo_root, "secrets/apple/AuthKey_*.p8")].first
    token = Spaceship::ConnectAPI::Token.create(
      key_id: key_id,
      issuer_id: issuer_id,
      filepath: key_filepath
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find("pro.daddoodev.godspeedginny")
    UI.user_error!("App not found in App Store Connect") unless app
    version = app.get_app_store_versions.find { |v| v.platform == "IOS" }
    UI.user_error!("No iOS App Store version") unless version

    vloc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    UI.user_error!("Missing en-US version localization") unless vloc
    vloc.update(
      attributes: {
        description: read.call(File.join(en, "description.txt")),
        keywords: read.call(File.join(en, "keywords.txt")),
        supportUrl: read.call(File.join(en, "support_url.txt")),
        marketingUrl: read.call(File.join(en, "marketing_url.txt")),
        promotionalText: read.call(File.join(en, "promotional_text.txt"))
      }
    )

    info = app.fetch_edit_app_info
    UI.user_error!("No editable app info") unless info
    iloc = info.get_app_info_localizations.find { |l| l.locale == "en-US" }
    UI.user_error!("Missing en-US app info localization") unless iloc
    iloc.update(
      attributes: {
        name: read.call(File.join(en, "name.txt")),
        subtitle: read.call(File.join(en, "subtitle.txt")),
        privacyPolicyUrl: read.call(File.join(en, "privacy_url.txt"))
      }
    )

    version.update(attributes: { copyright: read.call(File.join(meta, "copyright.txt")) })
    UI.success("App Store listing text uploaded for en-US")
  end

  desc "Upload App Store screenshots only"
  lane :upload_asc_screenshots do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: File.join(repo_root, "fastlane/screenshots"),
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :android do
  desc "Upload Play Store listing text only (no AAB, no images)"
  lane :upload_play_listing do
    require "supply"

    package = "pro.daddoodev.godspeedginny"
    lang = "en-US"
    dir = File.join(repo_root, "fastlane/metadata/android", lang)

    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, {
      json_key: File.join(repo_root, "secrets/google/play-store.json"),
      package_name: package,
      metadata_path: File.join(repo_root, "fastlane/metadata/android")
    })

    client = Supply::Client.make_from_config
    client.begin_edit(package_name: package)
    client.update_listing_for_language(
      language: lang,
      title: File.read(File.join(dir, "title.txt")).strip,
      short_description: File.read(File.join(dir, "short_description.txt")).strip,
      full_description: File.read(File.join(dir, "full_description.txt")).strip
    )
    client.commit_current_edit!
    UI.success("Play listing text uploaded for #{lang}")
  end

  desc "Upload Play Store icon + feature graphic"
  lane :upload_play_graphics do
    require "supply"

    package = "pro.daddoodev.godspeedginny"
    lang = "en-US"
    images = File.join(repo_root, "fastlane/metadata/android", lang, "images")

    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, {
      json_key: File.join(repo_root, "secrets/google/play-store.json"),
      package_name: package,
      metadata_path: File.join(repo_root, "fastlane/metadata/android")
    })

    client = Supply::Client.make_from_config
    client.begin_edit(package_name: package)

    icon = Dir[File.join(images, "icon.{png,PNG}")].first
    UI.user_error!("Missing 512x512 icon.png under #{images}") unless icon
    client.upload_image(image_path: icon, image_type: "icon", language: lang)
    UI.message("Uploaded #{File.basename(icon)}")

    feature = Dir[File.join(images, "featureGraphic.{png,PNG,jpg,JPG,jpeg,JPEG}")].first
    UI.user_error!("Missing 1024x500 featureGraphic under #{images}") unless feature
    client.upload_image(image_path: feature, image_type: "featureGraphic", language: lang)
    UI.message("Uploaded #{File.basename(feature)}")

    client.commit_current_edit!
    UI.success("Play icon + feature graphic uploaded for #{lang}")
  end

  desc "Upload Play Store phone screenshots only"
  lane :upload_play_screenshots do
    require "supply"

    package = "pro.daddoodev.godspeedginny"
    lang = "en-US"
    folder = File.join(repo_root, "fastlane/metadata/android", lang, "images", "phoneScreenshots")

    Supply.config = FastlaneCore::Configuration.create(Supply::Options.available_options, {
      json_key: File.join(repo_root, "secrets/google/play-store.json"),
      package_name: package,
      metadata_path: File.join(repo_root, "fastlane/metadata/android")
    })

    client = Supply::Client.make_from_config
    client.begin_edit(package_name: package)
    client.clear_screenshots(image_type: "phoneScreenshots", language: lang)
    Dir[File.join(folder, "*.{jpg,jpeg,png}")].sort.each do |path|
      client.upload_image(image_path: path, image_type: "phoneScreenshots", language: lang)
      UI.message("Uploaded #{File.basename(path)}")
    end
    client.commit_current_edit!
    UI.success("Play phone screenshots uploaded for #{lang}")
  end
end
